# Copy to .env (never commit .env).

# --- Local API (apps/api) ---
API_PORT=8787

# --- Gemma via Ollama (runs on this machine) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Preferred model. If it is not pulled yet, the API falls back to the first installed
# model among: gemma4:e2b, gemma4:e4b, gemma3:4b.
# CPU-only laptop: gemma4:e2b (fast). With a GPU or more patience: gemma4:e4b.
OLLAMA_MODEL=gemma4:e2b

# --- Walking routes (any OSRM-compatible server with a foot profile) ---
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot

# --- Web (apps/web) ---
# Public HTTPS URL where the static Walk page is deployed. Used in QR codes and invites.
# Phones need HTTPS for GPS, so leave empty only when testing on this computer.
VITE_PUBLIC_WALK_URL=
